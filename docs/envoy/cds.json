{
    "resources": [
        {
            "@type": "type.googleapis.com/envoy.config.cluster.v3.Cluster",
            "name": "mongot_rs_cluster",
            "type": "STRICT_DNS",
            "load_assignment": {
                "cluster_name": "mongot_rs_cluster",
                "endpoints": [
                    {
                        "lb_endpoints": [
                            {
                                "endpoint": {
                                    "address": {
                                        "socket_address": {
                                            "address": "mongot-search-0-svc.mongodb-poc.svc.cluster.local",
                                            "port_value": 27028
                                        }
                                    }
                                }
                            }
                        ]
                    }
                ]
            },
            "circuit_breakers": {
                "thresholds": [
                    {
                        "max_connections": 1024,
                        "max_pending_requests": 1024,
                        "max_requests": 1024,
                        "max_retries": 3
                    }
                ]
            },
            "typed_extension_protocol_options": {
                "envoy.extensions.upstreams.http.v3.HttpProtocolOptions": {
                    "@type": "type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions",
                    "common_http_protocol_options": {
                        "idle_timeout": "300s"
                    },
                    "explicit_http_config": {
                        "http2_protocol_options": {
                            "initial_stream_window_size": 1048576,
                            "initial_connection_window_size": 1048576,
                            "connection_keepalive": {
                                "interval": "60s",
                                "timeout": "10s"
                            }
                        }
                    }
                }
            },
            "transport_socket": {
                "name": "envoy.transport_sockets.tls",
                "typed_config": {
                    "@type": "type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext",
                    "common_tls_context": {
                        "tls_certificates": [
                            {
                                "certificate_chain": {
                                    "filename": "/etc/envoy/tls/client/tls.crt"
                                },
                                "private_key": {
                                    "filename": "/etc/envoy/tls/client/tls.key"
                                }
                            }
                        ],
                        "validation_context": {
                            "trusted_ca": {
                                "filename": "/etc/envoy/tls/ca/ca.crt"
                            }
                        },
                        "alpn_protocols": [
                            "h2"
                        ]
                    },
                    "sni": "mongot-search-0-svc.mongodb-poc.svc.cluster.local"
                }
            },
            "upstream_connection_options": {
                "tcp_keepalive": {
                    "keepalive_probes": 3,
                    "keepalive_time": 10,
                    "keepalive_interval": 3
                }
            }
        }
    ],
    "type_url": "type.googleapis.com/envoy.config.cluster.v3.Cluster"
}
