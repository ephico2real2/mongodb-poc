# What the kind mesh lab runs, in one place. The kind, node image, Cilium and cert-manager pins are those of
# cilium-implementation-poc (scripts/bootstrap/versions.env, scripts/lab-up.sh), where they were proven together.
KIND_VERSION=0.33.0
KIND_NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed
CILIUM_VERSION=1.20.2
# The agent the lab runs (story #145): our build of CILIUM_VERSION with Hubble naming the workload of a pod on another
# node of the same cluster (cilium-implementation-poc demo 39, scripts/bootstrap/versions.env). The chart stays the
# release's; only the images change. The build adds status.workloads to CiliumEndpoint, so its CRD goes on first,
# from the build's commit, with the schema version the build's operator would set (the release operator's is 1.33.12
# and it leaves a CRD labelled higher alone). #145's image: ghcr.io/ephico2real2/cilium-dev:1.20.2-remote-workload-1d3a02ab
# (multi-arch index sha256:d790f6c61bfa802a7f296390f56c4dfd2d0b5e488d2220c8721ccdca9e3754cd).
# Story #190 (fork branch hubble/remote-workload-clustermesh, commit 9e5a34a525 on 1d3a02ab1a) names the workload of a
# pod in another cluster of the mesh too: the clustermesh-apiserver writes a pod's workloads into its kvstore entry and
# the observing agent reads them, so it needs both images, the agent and CILIUM_CLUSTERMESH_IMAGE (the apiserver's etcd
# and kvstoremesh containers run that image too: the chart has one image key for the Deployment). The CiliumEndpoint
# CRD did not change, so the CRD pins stay #145's.
CILIUM_IMAGE=quay.io/cilium/cilium-dev:remote-workload-cm-9e5a34a5
CILIUM_CLUSTERMESH_IMAGE=quay.io/cilium/clustermesh-apiserver:remote-workload-cm-9e5a34a5
# 1: the images are built in the lab VM's docker and are in no registry, so every node gets them with
# `kind load docker-image` (nothing to pull; the chart's pullPolicy IfNotPresent finds them). Unset or 0: pulled.
CILIUM_IMAGES_LOCAL=1
CILIUM_CRD_URL=https://raw.githubusercontent.com/ephico2real2/cilium/1d3a02ab1a7647fea4b36843662619344c040b56/pkg/k8s/apis/cilium.io/client/crds/v2/ciliumendpoints.yaml
CILIUM_CRD_SCHEMA_VERSION=1.33.13
# What kind-mesh-cilium/scripts/cilium-build.sh expects before and after it rolls CILIUM_IMAGE in: the commit the lab's
# agents run before (#145's build; the release 1.20.2 prints e0dc92bd), and where Hubble names a destination pod's
# workload: node (the release: the observing agent's own node), cluster (#145: any node of its cluster) or mesh (#190:
# any cluster of the mesh). The next build is a change of these pins, not of the script.
CILIUM_BEFORE_COMMIT=1d3a02ab
CILIUM_BEFORE_SCOPE=cluster
CILIUM_SCOPE=mesh
CILIUM_CLI_VERSION=0.20.0
CERT_MANAGER_VERSION=v1.21.1
METRICS_SERVER_CHART=3.14.0
# OLM v0 from its GitHub release (crds.yaml, olm.yaml): its catalog operatorhubio-catalog carries mongodb-kubernetes.
OLM_VERSION=v0.46.0
OPERATOR_VERSION=1.13.0

# The Colima VM the three clusters run in, the kubeconfig that holds their contexts (never ~/.kube/config), and the
# kind nodes' addresses as colima-down.sh recorded them for colima-up.sh. CPU and memory reach a stopped VM at its next
# colima-up.sh; 24 GiB from 2026-10-22 (16 GiB left 1,240 MiB available with the three clusters up, #162). The docker
# disk can only grow, also at colima-up.sh: 100 GiB from 2026-10-22, when 60 was 80% used and mongot, whose volumes are
# this disk, stops indexing above 85% (#182).
COLIMA_PROFILE=mongodb-mesh
COLIMA_CPUS=8
COLIMA_MEMORY_GIB=24
COLIMA_DISK_GIB=100
MESH_KUBECONFIG=$HOME/.kube/mongodb-mesh.config
MESH_NODE_IPS=$HOME/.kube/mongodb-mesh.node-ips

# The kind docker network: containers from the lower /17, each cluster's LoadBalancer block in 172.18.255.0/24.
LAB_SUBNET=172.18.0.0/16
LAB_IP_RANGE=172.18.0.0/17
LB_RANGE=172.18.255.0/24
CLUSTERS="mesh0 mesh1 mesh2"
