# ─── The ONLY things you change to move this to another network ───────────────
# Address the replica set advertises. Must be reachable FROM the mongot pods.
#   colima VM (proven: pod -> 192.168.64.4 OK) ....... 192.168.64.4
#   inside the CRC VM (podman) ....................... 192.168.127.2
ADVERTISED_HOST=192.168.64.4

# The name mongod dials for search, and the IP it resolves to. compose.yaml adds both
# names to each container's /etc/hosts (extra_hosts), so these MUST be set - leaving
# either blank makes `docker compose` fail with
#   "services.mongo3.extra_hosts must be a mapping".
# SEARCH_HOST is the externalHostname on the MongoDBSearch CR, the passthrough Route
# host, and a SAN on Envoy's server certificate: one string in all four places.
SEARCH_HOST=grpc-search.apps-crc.testing
VIP_HOST=vip-grpc-search.apps-crc.testing
GATEWAY_IP=192.168.64.1

# Where mongod sends search traffic. ONE hostname, two ports - SNI is hostname-only,
# so the same certificate and the same externalHostname serve both entry paths:
#   :27028 -> Mac forwarder -> MetalLB VIP -> Envoy
#   :443   -> Mac           -> CRC router  -> passthrough Route -> Envoy
# With TLS on this MUST be a hostname, never an IP: TLS clients send no SNI for an IP
# literal, so no Envoy filter chain matches and the connection is dropped.
MONGOT_ENDPOINT=grpc-search.apps-crc.testing:443

# searchTLSMode on mongod: requireTLS once Envoy has TLS, disabled while plaintext.
SEARCH_TLS_MODE=requireTLS
# ──────────────────────────────────────────────────────────────────────────────

REPLSET=rs0
PORT1=27017
PORT2=27018
PORT3=27019
# 8.3.4-ubi9 publishes linux/arm64 (the bare 8.3.4 tag does not)
MONGO_IMAGE=docker.io/mongodb/mongodb-community-server:8.3.4-ubi9
MONGO_UID=1000
MONGO_GID=1000
# colima has ~2.8GiB free; keep the WiredTiger cache small
WT_CACHE_GB=0.25
ROOT_USER=labAdmin
ROOT_PASSWORD=CHANGEME-root-password
SEARCH_USER=search-sync-source
SEARCH_PASSWORD=CHANGEME-sync-source-password
