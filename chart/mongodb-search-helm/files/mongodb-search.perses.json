{
  "display": {
    "name": "MongoDB Search"
  },
  "variables": [],
  "panels": {
    "0_0": {
      "kind": "Panel",
      "spec": {
        "display": {
          "name": "mongot pods up",
          "description": "mongot pods that Prometheus scrapes successfully."
        },
        "plugin": {
          "kind": "StatChart",
          "spec": {
            "calculation": "last-number",
            "colorMode": "value",
            "format": {
              "unit": "decimal"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "#f2495c",
                  "value": 0
                },
                {
                  "color": "#73bf69",
                  "value": 1
                }
              ]
            }
          }
        },
        "queries": [
          {
            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "__SEARCH__-thanos"
                  },
                  "query": "count(up{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-search-0-svc\"} == 1) or vector(0)"
                }
              }
            }
          }
        ]
      }
    },
    "0_1": {
      "kind": "Panel",
      "spec": {
        "display": {
          "name": "Envoy pods up",
          "description": "Envoy pods that Prometheus scrapes successfully."
        },
        "plugin": {
          "kind": "StatChart",
          "spec": {
            "calculation": "last-number",
            "colorMode": "value",
            "format": {
              "unit": "decimal"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "#f2495c",
                  "value": 0
                },
                {
                  "color": "#73bf69",
                  "value": 1
                }
              ]
            }
          }
        },
        "queries": [
          {
            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "__SEARCH__-thanos"
                  },
                  "query": "count(up{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-envoy-stats\"} == 1) or vector(0)"
                }
              }
            }
          }
        ]
      }
    },
    "0_2": {
      "kind": "Panel",
      "spec": {
        "display": {
          "name": "mongot pods in Envoy",
          "description": "The smallest number of healthy mongot pods any Envoy pod sees. Below the number of mongot pods, an Envoy pod has lost one."
        },
        "plugin": {
          "kind": "StatChart",
          "spec": {
            "calculation": "last-number",
            "colorMode": "value",
            "format": {
              "unit": "decimal"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "#f2495c",
                  "value": 0
                },
                {
                  "color": "#73bf69",
                  "value": 1
                }
              ]
            }
          }
        },
        "queries": [
          {
            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "__SEARCH__-thanos"
                  },
                  "query": "min(envoy_cluster_membership_healthy{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-envoy-stats\",envoy_cluster_name=\"mongot_rs_cluster\"})"
                }
              }
            }
          }
        ]
      }
    },
    "0_3": {
      "kind": "Panel",
      "spec": {
        "display": {
          "name": "Searches per second",
          "description": "Text and vector searches, all mongot pods, 5 minute rate."
        },
        "plugin": {
          "kind": "StatChart",
          "spec": {
            "calculation": "last-number",
            "colorMode": "value",
            "format": {
              "decimalPlaces": 2,
              "unit": "requests/sec"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "#73bf69",
                  "value": 0
                }
              ]
            }
          }
        },
        "queries": [
          {
            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "__SEARCH__-thanos"
                  },
                  "query": "sum((rate(mongot_command_searchCommandTotalLatency_seconds_count{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-search-0-svc\"}[5m]) + rate(mongot_command_vectorSearchCommandTotalLatency_seconds_count{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-search-0-svc\"}[5m])))"
                }
              }
            }
          }
        ]
      }
    },
    "0_4": {
      "kind": "Panel",
      "spec": {
        "display": {
          "name": "Largest share on one pod",
          "description": "The share of all searches that the busiest mongot pod served. With three pods and even balancing this is about 33%. Near 100% means one pod serves everything while the others stay Ready: the failure that produces no error. 0% when no search ran in the last 5 minutes."
        },
        "plugin": {
          "kind": "StatChart",
          "spec": {
            "calculation": "last-number",
            "colorMode": "value",
            "format": {
              "decimalPlaces": 0,
              "unit": "percent-decimal"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "#73bf69",
                  "value": 0
                },
                {
                  "color": "#ff9830",
                  "value": 0.6
                },
                {
                  "color": "#f2495c",
                  "value": 0.9
                }
              ]
            }
          }
        },
        "queries": [
          {
            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "__SEARCH__-thanos"
                  },
                  "query": "(max(sum by (pod) ((rate(mongot_command_searchCommandTotalLatency_seconds_count{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-search-0-svc\"}[5m]) + rate(mongot_command_vectorSearchCommandTotalLatency_seconds_count{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-search-0-svc\"}[5m])))) / (sum((rate(mongot_command_searchCommandTotalLatency_seconds_count{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-search-0-svc\"}[5m]) + rate(mongot_command_vectorSearchCommandTotalLatency_seconds_count{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-search-0-svc\"}[5m]))) > 0)) or vector(0)"
                }
              }
            }
          }
        ]
      }
    },
    "1_0": {
      "kind": "Panel",
      "spec": {
        "display": {
          "name": "Searches per second, per mongot pod",
          "description": "Envoy picks a mongot pod per request, so the lines should sit together."
        },
        "plugin": {
          "kind": "TimeSeriesChart",
          "spec": {
            "legend": {
              "mode": "list",
              "position": "bottom"
            },
            "visual": {
              "areaOpacity": 0.1,
              "lineWidth": 1
            },
            "yAxis": {
              "format": {
                "unit": "requests/sec"
              }
            }
          }
        },
        "queries": [
          {
            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "__SEARCH__-thanos"
                  },
                  "query": "sum by (pod) ((rate(mongot_command_searchCommandTotalLatency_seconds_count{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-search-0-svc\"}[5m]) + rate(mongot_command_vectorSearchCommandTotalLatency_seconds_count{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-search-0-svc\"}[5m])))",
                  "seriesNameFormat": "{{pod}}"
                }
              }
            }
          }
        ]
      }
    },
    "1_1": {
      "kind": "Panel",
      "spec": {
        "display": {
          "name": "Share of searches, per mongot pod",
          "description": "Each pod's part of all searches."
        },
        "plugin": {
          "kind": "TimeSeriesChart",
          "spec": {
            "legend": {
              "mode": "list",
              "position": "bottom"
            },
            "visual": {
              "areaOpacity": 0.1,
              "lineWidth": 1
            },
            "yAxis": {
              "format": {
                "unit": "percent-decimal"
              }
            }
          }
        },
        "queries": [
          {
            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "__SEARCH__-thanos"
                  },
                  "query": "sum by (pod) ((rate(mongot_command_searchCommandTotalLatency_seconds_count{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-search-0-svc\"}[5m]) + rate(mongot_command_vectorSearchCommandTotalLatency_seconds_count{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-search-0-svc\"}[5m]))) / scalar(sum((rate(mongot_command_searchCommandTotalLatency_seconds_count{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-search-0-svc\"}[5m]) + rate(mongot_command_vectorSearchCommandTotalLatency_seconds_count{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-search-0-svc\"}[5m]))))",
                  "seriesNameFormat": "{{pod}}"
                }
              }
            }
          }
        ]
      }
    },
    "2_0": {
      "kind": "Panel",
      "spec": {
        "display": {
          "name": "Requests per second to mongot, per Envoy pod",
          "description": "One Envoy pod at zero is normal with one mongod connection: the Route places connections, not requests."
        },
        "plugin": {
          "kind": "TimeSeriesChart",
          "spec": {
            "legend": {
              "mode": "list",
              "position": "bottom"
            },
            "visual": {
              "areaOpacity": 0.1,
              "lineWidth": 1
            },
            "yAxis": {
              "format": {
                "unit": "requests/sec"
              }
            }
          }
        },
        "queries": [
          {
            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "__SEARCH__-thanos"
                  },
                  "query": "sum by (pod) (rate(envoy_cluster_upstream_rq_total{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-envoy-stats\",envoy_cluster_name=\"mongot_rs_cluster\"}[5m]))",
                  "seriesNameFormat": "{{pod}}"
                }
              }
            }
          }
        ]
      }
    },
    "2_1": {
      "kind": "Panel",
      "spec": {
        "display": {
          "name": "Open connections from mongod, per Envoy pod",
          "description": "Where the Route's balance algorithm put each connection."
        },
        "plugin": {
          "kind": "TimeSeriesChart",
          "spec": {
            "legend": {
              "mode": "list",
              "position": "bottom"
            },
            "visual": {
              "areaOpacity": 0.1,
              "lineWidth": 1
            },
            "yAxis": {
              "format": {
                "unit": "decimal"
              }
            }
          }
        },
        "queries": [
          {
            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "__SEARCH__-thanos"
                  },
                  "query": "sum by (pod) (envoy_listener_downstream_cx_active{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-envoy-stats\",envoy_listener_address=\"0.0.0.0_27028\"})",
                  "seriesNameFormat": "{{pod}}"
                }
              }
            }
          }
        ]
      }
    },
    "2_2": {
      "kind": "Panel",
      "spec": {
        "display": {
          "name": "Retries per second, per Envoy pod",
          "description": "Envoy retries onto another mongot pod when one sheds load or resets a stream. Sustained retries mean mongot is undersized."
        },
        "plugin": {
          "kind": "TimeSeriesChart",
          "spec": {
            "legend": {
              "mode": "list",
              "position": "bottom"
            },
            "visual": {
              "areaOpacity": 0.1,
              "lineWidth": 1
            },
            "yAxis": {
              "format": {
                "unit": "requests/sec"
              }
            }
          }
        },
        "queries": [
          {
            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "__SEARCH__-thanos"
                  },
                  "query": "sum by (pod) (rate(envoy_cluster_upstream_rq_retry_total{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-envoy-stats\",envoy_cluster_name=\"mongot_rs_cluster\"}[5m]))",
                  "seriesNameFormat": "{{pod}}"
                }
              }
            }
          }
        ]
      }
    },
    "2_3": {
      "kind": "Panel",
      "spec": {
        "display": {
          "name": "Responses per second from mongot, by class",
          "description": "2xx is success. gRPC errors still answer 200; see the search failures panel."
        },
        "plugin": {
          "kind": "TimeSeriesChart",
          "spec": {
            "legend": {
              "mode": "list",
              "position": "bottom"
            },
            "visual": {
              "areaOpacity": 0.1,
              "lineWidth": 1
            },
            "yAxis": {
              "format": {
                "unit": "requests/sec"
              }
            }
          }
        },
        "queries": [
          {
            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "__SEARCH__-thanos"
                  },
                  "query": "sum by (envoy_response_code_class) (rate(envoy_cluster_upstream_rq_xx_total{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-envoy-stats\",envoy_cluster_name=\"mongot_rs_cluster\"}[5m]))",
                  "seriesNameFormat": "{{envoy_response_code_class}}xx"
                }
              }
            }
          }
        ]
      }
    },
    "2_4": {
      "kind": "Panel",
      "spec": {
        "display": {
          "name": "Envoy to mongot latency, 95th percentile",
          "description": "Time Envoy waited for mongot, across both Envoy pods."
        },
        "plugin": {
          "kind": "TimeSeriesChart",
          "spec": {
            "legend": {
              "mode": "list",
              "position": "bottom"
            },
            "visual": {
              "areaOpacity": 0.1,
              "lineWidth": 1
            },
            "yAxis": {
              "format": {
                "unit": "milliseconds"
              }
            }
          }
        },
        "queries": [
          {
            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "__SEARCH__-thanos"
                  },
                  "query": "histogram_quantile(0.95, sum by (le) (rate(envoy_cluster_upstream_rq_time_bucket{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-envoy-stats\",envoy_cluster_name=\"mongot_rs_cluster\"}[5m])))",
                  "seriesNameFormat": "p95"
                }
              }
            }
          }
        ]
      }
    },
    "3_0": {
      "kind": "Panel",
      "spec": {
        "display": {
          "name": "Average search latency, per mongot pod",
          "description": "Text searches only. No line while a pod serves none."
        },
        "plugin": {
          "kind": "TimeSeriesChart",
          "spec": {
            "legend": {
              "mode": "list",
              "position": "bottom"
            },
            "visual": {
              "areaOpacity": 0.1,
              "lineWidth": 1
            },
            "yAxis": {
              "format": {
                "unit": "seconds"
              }
            }
          }
        },
        "queries": [
          {
            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "__SEARCH__-thanos"
                  },
                  "query": "sum by (pod) (rate(mongot_command_searchCommandTotalLatency_seconds_sum{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-search-0-svc\"}[5m])) / sum by (pod) (rate(mongot_command_searchCommandTotalLatency_seconds_count{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-search-0-svc\"}[5m]))",
                  "seriesNameFormat": "{{pod}}"
                }
              }
            }
          }
        ]
      }
    },
    "3_1": {
      "kind": "Panel",
      "spec": {
        "display": {
          "name": "Search failures per second, per mongot pod",
          "description": "Text and vector searches that mongot failed."
        },
        "plugin": {
          "kind": "TimeSeriesChart",
          "spec": {
            "legend": {
              "mode": "list",
              "position": "bottom"
            },
            "visual": {
              "areaOpacity": 0.1,
              "lineWidth": 1
            },
            "yAxis": {
              "format": {
                "unit": "requests/sec"
              }
            }
          }
        },
        "queries": [
          {
            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "__SEARCH__-thanos"
                  },
                  "query": "sum by (pod) (rate(mongot_command_searchCommandFailure_total{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-search-0-svc\"}[5m]) + rate(mongot_command_vectorSearchCommandFailure_total{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-search-0-svc\"}[5m]))",
                  "seriesNameFormat": "{{pod}}"
                }
              }
            }
          }
        ]
      }
    },
    "3_2": {
      "kind": "Panel",
      "spec": {
        "display": {
          "name": "Replication lag, per mongot pod",
          "description": "How far the pod's most delayed index is behind the source replica set."
        },
        "plugin": {
          "kind": "TimeSeriesChart",
          "spec": {
            "legend": {
              "mode": "list",
              "position": "bottom"
            },
            "visual": {
              "areaOpacity": 0.1,
              "lineWidth": 1
            },
            "yAxis": {
              "format": {
                "unit": "milliseconds"
              }
            }
          }
        },
        "queries": [
          {
            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "__SEARCH__-thanos"
                  },
                  "query": "max by (pod) (mongot_index_stats_indexing_replicationLagMs{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-search-0-svc\"})",
                  "seriesNameFormat": "{{pod}}"
                }
              }
            }
          }
        ]
      }
    },
    "3_3": {
      "kind": "Panel",
      "spec": {
        "display": {
          "name": "JVM memory used, per mongot pod",
          "description": "Heap and non-heap together."
        },
        "plugin": {
          "kind": "TimeSeriesChart",
          "spec": {
            "legend": {
              "mode": "list",
              "position": "bottom"
            },
            "visual": {
              "areaOpacity": 0.1,
              "lineWidth": 1
            },
            "yAxis": {
              "format": {
                "unit": "bytes"
              }
            }
          }
        },
        "queries": [
          {
            "kind": "TimeSeriesQuery",
            "spec": {
              "plugin": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "datasource": {
                    "kind": "PrometheusDatasource",
                    "name": "__SEARCH__-thanos"
                  },
                  "query": "sum by (pod) (mongot_jvm_memory_used_bytes{namespace=\"__NAMESPACE__\",job=\"__SEARCH__-search-0-svc\"})",
                  "seriesNameFormat": "{{pod}}"
                }
              }
            }
          }
        ]
      }
    }
  },
  "layouts": [
