          {
            "x": 12,
            "y": 23,
            "width": 12,
            "height": 8,
            "content": {
              "$ref": "#/spec/panels/2_3"
            }
          },
          {
            "x": 0,
            "y": 31,
            "width": 24,
            "height": 8,
            "content": {
